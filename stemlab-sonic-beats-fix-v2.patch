+
+    _sv, xml = build_session(tmp_path / "sv", master, [], [])
+    root = ET.fromstring(xml.read_bytes())
+    data = root.find("data")
+    assert data is not None
+
+    text_models = [
+        model
+        for model in data.findall("model")
+        if model.attrib.get("subtype") == "text"
