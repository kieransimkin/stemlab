def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__.strip())
        return 2
    raw = base64.b85decode(PAYLOAD.encode("ascii"))
    with tempfile.TemporaryDirectory(prefix="stemlab-v021-patch-") as tmp:
        tmp_path = Path(tmp)
        with zipfile.ZipFile(io.BytesIO(raw)) as archive:
            archive.extractall(tmp_path)
        kit = tmp_path / "stemlab-comprehensive-analysis-v0.2.1"
        applier = kit / "apply_upgrade.py"
        sys.argv = [str(applier), *sys.argv[1:]]
        runpy.run_path(str(applier), run_name="__main__")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
