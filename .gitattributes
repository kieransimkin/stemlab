# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf

# Canonical lyric timing files are byte-sensitive reference assets.
examples/arcadians/*.lrc binary

# Frozen detector evidence is byte-pinned, including its original newlines.
examples/the-truth-is-a-virus/*.json -text
examples/the-truth-is-a-virus/beats/*.json -text

# Keep original DanceFlow artwork byte-identical across platform packages.
**/branding/*.svg text eol=lf
**/branding/*.png binary

# Released-viewer build receipts hash these exact bytes across Windows and Linux.
src/stemlab/web/app.js text eol=lf
src/stemlab/web/timeline.css text eol=lf
.github/viewer-*.json text eol=lf
.github/dancerudiments-recording-ref text eol=lf

# Canonical cross-platform checkout policy. Text evidence is normalised to LF;
# binary media and package payloads remain byte-exact.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.wasm binary
*.whl binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.flac binary
*.mp4 binary
*.webm binary
*.onnx binary
*.safetensors binary
*.gguf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
