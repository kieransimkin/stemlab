#!/usr/bin/env python
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


FILES = (
    Path("src/stemlab/analysis/lyrics.py"),
    Path("src/stemlab/analysis/rhythm.py"),
)


def run(cmd: list[str], cwd: Path) -> None:
    print("+", " ".join(cmd))
    subprocess.run(cmd, cwd=cwd, check=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="StemLab v0.2.3 CI fix: remove two unused math imports and validate."
    )
    parser.add_argument("repository", nargs="?", default=".")
    parser.add_argument("--no-validate", action="store_true")
    args = parser.parse_args()

    root = Path(args.repository).expanduser().resolve()
    if not (root / ".git").exists() or not (root / "pyproject.toml").is_file():
        parser.error(f"Not a StemLab checkout: {root}")

    changed = []
    for rel in FILES:
        path = root / rel
        if not path.is_file():
            raise SystemExit(f"Expected file is missing: {rel}")
        text = path.read_text(encoding="utf-8")
        old = "from __future__ import annotations\n\nimport math\n"
        new = "from __future__ import annotations\n"
        if old in text:
            path.write_text(text.replace(old, new, 1), encoding="utf-8", newline="\n")
            changed.append(str(rel))
            print(f"fixed: {rel}")
        elif "\nimport math\n" in text:
            path.write_text(text.replace("\nimport math\n", "\n", 1), encoding="utf-8", newline="\n")
            changed.append(str(rel))
            print(f"fixed: {rel}")
        else:
            print(f"already fixed: {rel}")

    if args.no_validate:
        print("Validation skipped.")
        return 0

    run([sys.executable, "-m", "compileall", "-q", "src", "tests"], root)
    run([sys.executable, "-m", "pytest", "-q"], root)

    # Prefer the active environment's Ruff module so Windows venv resolution is deterministic.
    run([sys.executable, "-m", "ruff", "check", "src", "tests", "scripts"], root)
    run(["git", "diff", "--check"], root)

    print("\nStemLab v0.2.3 CI fix applied and validated successfully.")
    if changed:
        print("Changed:", ", ".join(changed))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
