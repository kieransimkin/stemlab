+def _canonicalise_session_layers(data, display) -> None:
+    """Write layers in Sonic Visualiser's native session-file layout.
+
+    A real ``.sv``/``.svt`` session defines every layer once in ``<data>``
+    and puts only a lightweight reference to that layer inside each ``<view>``.
+    Layer-only ``.svl`` exports use a different layout, and Sonic Visualiser's
+    reader has a compatibility fallback that can create an undefined layer when
+    it encounters one inside a view.  Relying on that fallback is fragile for
+    sparse annotation layers (time instants / regions), which is exactly where
+    the beat tracks live.
+
+    StemLab builds views first because it is convenient to keep layer creation
+    next to the pane it belongs to.  Immediately before serialisation we move a
+    complete copy of every layer definition into ``<data>`` and reduce the
+    view-side element to the normal visible layer reference.
+    """
+    definitions: list[dict[str, str]] = []
+    seen_ids: set[str] = set()
+
+    for view in display.findall("view"):
+        # Mandatory in Sonic Visualiser's session reader.  Older StemLab files
+        # omitted it; the reader created a pane and then reported the view as
+        # incomplete.
+        view.set("centreLineVisible", view.get("centreLineVisible", "1"))
+
+        for layer in view.findall("layer"):
+            attrs = dict(layer.attrib)
+            layer_id = attrs.get("id")
+            if not layer_id:
+                continue
+
+            if layer_id not in seen_ids:
+                definition = dict(attrs)
+                definition.pop("visible", None)
+                if definition.get("name") and not definition.get("presentationName"):
+                    definition["presentationName"] = definition["name"]
+                definitions.append(definition)
+                seen_ids.add(layer_id)
+
+            reference = {
+                key: attrs[key]
+                for key in ("id", "type", "name", "model")
+                if key in attrs
+            }
+            reference["visible"] = "true"
+            layer.attrib.clear()
+            layer.attrib.update(reference)
+
+    # Append only after all model/dataset elements have been written: the SV
+    # reader explicitly expects every model to precede the first layer.
+    for attrs in definitions:
+        ET.SubElement(data, "layer", attrs)
