  "lyrics": {
    "status": "complete",
    "track_count": 1,
    "canonical_track_count": 1,
    "tracks": [
      {
        "track_number": 1,
        "track_title": "Arcadians",
        "isrc": "QT6EB2639508",
        "canonical_path": "canonical-lyrics/01 - QT6EB2639508 - Arcadians.txt",
        "bytes": 1379,
        "sha256": "3211562728d8259f537dba5d29702ba76f00bfeb95258340e066cc5b68e433e0",
        "encoding": "utf-8",
        "text": "No crown, no concrete\nJust mountain breath and moonlit stone\nArcadia...\nWhere the green stays gold\n\nPan in the pines, river in the light\nWildflower fires in the velvet night\nOld-world echoes under the trees\nOne land, one heart, one harmony\n\nHear the pipes through the valley below\nAncient rivers, timeless flow\nNo chains on the roots, no walls in the sky\nArcadia calling, we rise, we rise\n\nPan on the pipe\nWind in the pines\nMountain pulse in the bloodline\nHigher, higher, into the light\nWild green world, electrify\n\nAR-CA-DI-A!\nWild green frequency!\nBass in the valley, roots in the beat\nUnspoiled heaven under our feet!\n\nAR-CA-DI-A!\nLet the mountains shake!\nPan’s pipe screaming while the earth wakes\nNature in balance—\nBREAK! BREAK! BREAK!\n\nArcadia...\nArcadia...\n\nCallisto’s stars on the mountainside\nArcas dreaming where the rivers glide\nShepherd songs in the open air\nNo empire owns what the wild can share\n\nHear the pipes through the valley below\nAncient rivers, timeless flow\nNo chains on the roots, no walls in the sky\nArcadia calling, we rise, we rise\n\nAR-CA-DI-A!\nWild green frequency!\nThunder in the hills, fire in the leaves\nThe wild stays free when the people believe!\n\nAR-CA-DI-A!\nLet the mountains shake!\nPan’s pipe screaming while the earth wakes\nNature in balance—\nBREAK! BREAK! BREAK!\n\nFrom the old highlands\nTo the sound-system sky\nArcadia never died\n"
      }
    ],
