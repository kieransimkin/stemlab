diff --git a/docker/Dockerfile b/docker/Dockerfile
index 7f495f5..1bc2e6d 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -4,8 +4,8 @@ ARG DEBIAN_FRONTEND=noninteractive
 ARG STEMLAB_REPO=https://github.com/kieransimkin/stemlab.git
 ARG STEMLAB_REF=latest
 ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
-ARG TORCH_VERSION=2.14.0
-ARG TORCHAUDIO_VERSION=2.14.0
+ARG TORCH_VERSION=2.11.0
+ARG TORCHAUDIO_VERSION=2.11.0

 ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
     PIP_NO_CACHE_DIR=1 \
@@ -57,9 +57,9 @@ RUN chmod +x /opt/stemlab-docker/*.sh

-# Keep torch/torchaudio internally matched in Docker even though the original
-# working Windows snapshot contained torch 2.14.0+cpu with torchaudio 2.11.0.
-# Matching binaries avoid ABI surprises while preserving the same torch series.
+# Keep torch/torchaudio on an officially published matched pair. PyTorch's
+# CUDA 13.0 wheel index currently publishes torchaudio through 2.11.0, so
+# pin both packages to 2.11.0 rather than mixing binary generations.
 RUN python -m pip install --upgrade pip setuptools wheel \
     && python -m pip install \
         --index-url "${TORCH_INDEX_URL}" \
