diff --git a/docker/Dockerfile b/docker/Dockerfile
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -5,7 +5,7 @@ ARG STEMLAB_REPO=https://github.com/kieransimkin/stemlab.git
 ARG STEMLAB_REF=latest
 ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
 ARG TORCH_VERSION=2.14.0
-ARG TORCHAUDIO_VERSION=2.14.0
+ARG TORCHAUDIO_VERSION=2.11.0

 ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
     PIP_NO_CACHE_DIR=1 \
@@ -56,10 +56,10 @@ COPY docker/start-web-service.sh /opt/stemlab-docker/start-web-service.sh

 RUN chmod +x /opt/stemlab-docker/*.sh

-# Keep torch/torchaudio internally matched in Docker even though the original
-# working Windows snapshot contained torch 2.14.0+cpu with torchaudio 2.11.0.
-# Matching binaries avoid ABI surprises while preserving the same torch series.
+# Mirror the known-working StemLab environment: torch 2.14 with torchaudio
+# 2.11. TorchAudio 2.11 uses PyTorch's stable ABI and supports PyTorch 2.11+
+# while the CUDA 13.0 index does not publish a torchaudio 2.14 wheel.
 RUN python -m pip install --upgrade pip setuptools wheel \
     && python -m pip install \
         --index-url "${TORCH_INDEX_URL}" \
diff --git a/compose.yaml b/compose.yaml
--- a/compose.yaml
+++ b/compose.yaml
@@ -10,7 +10,7 @@ services:
         STEMLAB_REF: ${STEMLAB_REF:-latest}
         TORCH_INDEX_URL: ${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu130}
         TORCH_VERSION: ${TORCH_VERSION:-2.14.0}
-        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.14.0}
+        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.11.0}
     gpus: all
     shm_size: "8gb"
     environment:
@@ -39,7 +39,7 @@ services:
         STEMLAB_REF: ${STEMLAB_REF:-latest}
         TORCH_INDEX_URL: ${TORCH_CPU_INDEX_URL:-https://download.pytorch.org/whl/cpu}
         TORCH_VERSION: ${TORCH_VERSION:-2.14.0}
-        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.14.0}
+        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.11.0}
     shm_size: "8gb"
     environment:
       STEMLAB_TEST_PROFILE: ${STEMLAB_TEST_PROFILE:-fast}
@@ -68,7 +68,7 @@ services:
         STEMLAB_REF: ${STEMLAB_REF:-latest}
         TORCH_INDEX_URL: ${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu130}
         TORCH_VERSION: ${TORCH_VERSION:-2.14.0}
-        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.14.0}
+        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.11.0}
     gpus: all
     shm_size: "8gb"
     ports:
@@ -104,7 +104,7 @@ services:
         STEMLAB_REF: ${STEMLAB_REF:-latest}
         TORCH_INDEX_URL: ${TORCH_CPU_INDEX_URL:-https://download.pytorch.org/whl/cpu}
         TORCH_VERSION: ${TORCH_VERSION:-2.14.0}
-        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.14.0}
+        TORCHAUDIO_VERSION: ${TORCHAUDIO_VERSION:-2.11.0}
     shm_size: "8gb"
     ports:
       - "${STEMLAB_WEB_PORT:-8000}:8000"
