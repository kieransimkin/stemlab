+    playhead.style.left = `${LABEL_WIDTH() + time * this.pps}px`;
+    timeDisplay.textContent = `${fmtTime(time)} / ${fmtTime(this.duration)}`;
+
+    if (!audio.paused && followPlayhead.checked && !this.autoScrollLock) {
+      const x = LABEL_WIDTH() + time * this.pps;
