+  }
+
+  createLane(key, title, meta, kind) {
+    if (this.lanes.has(key)) return this.lanes.get(key);
+    const lane = document.createElement("div");
+    lane.className = `lane lane-${kind}`;
+    lane.dataset.key = key;
