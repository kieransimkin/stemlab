#!/usr/bin/env python
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

TEST = 'from pathlib import Path\n\ntry:\n    import tomllib\nexcept ModuleNotFoundError:  # Python 3.10\n    import tomli as tomllib\n\n\ndef test_stemlab_canonical_identity_is_not_distribution_name():\n    root = Path(__file__).resolve().parents[1]\n    pyproject = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8"))\n    readme = (root / "README.md").read_text(encoding="utf-8")\n\n    # The registry coordinate is namespaced under Dance Flow because the bare\n    # PyPI name is unavailable. It must not rename the product itself.\n    assert pyproject["project"]["name"] == "danceflow-stemlab"\n    assert pyproject["project"]["scripts"]["stemlab"] == "stemlab.cli:app"\n    assert readme.startswith("# StemLab")\n    assert "canonical project name is **StemLab**" in readme\n    assert "pip install danceflow-stemlab" in readme\n'

def run(cmd: list[str], cwd: Path) -> None:
    print("+", " ".join(cmd))
    subprocess.run(cmd, cwd=cwd, check=True)

def main() -> int:
    parser = argparse.ArgumentParser(
        description="StemLab v0.2.6 Python 3.10 compatibility fix for distribution identity tests."
    )
    parser.add_argument("repository", nargs="?", default=".")
    parser.add_argument("--no-validate", action="store_true")
    args = parser.parse_args()

    root = Path(args.repository).expanduser().resolve()
    if not (root / ".git").exists() or not (root / "pyproject.toml").is_file():
        parser.error(f"Not a StemLab checkout: {root}")

    pyproject_path = root / "pyproject.toml"
    pyproject = pyproject_path.read_text(encoding="utf-8")
    old = 'dev = ["pytest>=8.0", "ruff>=0.6", "build>=1.2"]'
    new = 'dev = ["pytest>=8.0", "ruff>=0.6", "build>=1.2", "tomli>=2; python_version < \'3.11\'"]'
    if new not in pyproject:
        if old not in pyproject:
            raise SystemExit("Could not locate StemLab dev optional-dependency line.")
        pyproject = pyproject.replace(old, new, 1)
        pyproject_path.write_text(pyproject, encoding="utf-8", newline="\n")
        print("updated: pyproject.toml (explicit tomli backport for Python 3.10 dev/test)")
    else:
        print("already fixed: pyproject.toml")

    test_path = root / "tests" / "test_distribution_identity.py"
    test_path.write_text(TEST, encoding="utf-8", newline="\n")
    print("updated: tests/test_distribution_identity.py")

    if args.no_validate:
        print("Validation skipped.")
        return 0

    run([sys.executable, "-m", "pytest", "-q", "tests/test_distribution_identity.py"], root)
    run([sys.executable, "-m", "ruff", "check", "tests/test_distribution_identity.py"], root)
    run(["git", "diff", "--check"], root)

    print("\nStemLab v0.2.6 Python 3.10 compatibility fix applied successfully.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
