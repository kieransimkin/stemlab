@@ -0,0 +1,77 @@
+FROM python:3.13-bookworm
+
+ARG DEBIAN_FRONTEND=noninteractive
+ARG STEMLAB_REPO=https://github.com/kieransimkin/stemlab.git
+ARG STEMLAB_REF=latest
+ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
+ARG TORCH_VERSION=2.14.0
+ARG TORCHAUDIO_VERSION=2.14.0
+
+ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
+    PIP_NO_CACHE_DIR=1 \
+    PYTHONUNBUFFERED=1 \
+    STEMLAB_REPO=${STEMLAB_REPO} \
+    STEMLAB_REF=${STEMLAB_REF} \
+    HF_HOME=/root/.cache/huggingface \
+    TORCH_HOME=/root/.cache/torch \
+    VAMP_PATH=/root/.vamp
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    bash \
+    build-essential \
+    ca-certificates \
+    curl \
+    ffmpeg \
+    git \
+    jq \
+    libasound2 \
+    libfftw3-3 \
+    libfftw3-dev \
+    libgl1 \
+    libglib2.0-0 \
+    libgomp1 \
+    libjack-jackd2-0 \
+    libsamplerate0 \
+    libsndfile1 \
+    libsndfile1-dev \
+    libx11-6 \
+    libxext6 \
+    libxkbcommon-x11-0 \
+    libxrender1 \
+    procps \
+    unzip \
+    wget \
+    xdotool \
+    xvfb \
+    && rm -rf /var/lib/apt/lists/*
+
+COPY docker/requirements.lock.txt /opt/stemlab-docker/requirements.lock.txt
+COPY docker/install-sonic-annotator.sh /opt/stemlab-docker/install-sonic-annotator.sh
+COPY docker/install-vamp-pack.sh /opt/stemlab-docker/install-vamp-pack.sh
+COPY docker/install-stemlab.sh /opt/stemlab-docker/install-stemlab.sh
+COPY docker/verify-environment.sh /opt/stemlab-docker/verify-environment.sh
+COPY docker/entrypoint.sh /opt/stemlab-docker/entrypoint.sh
+
+RUN chmod +x /opt/stemlab-docker/*.sh
+
+# Keep torch/torchaudio internally matched in Docker even though the original
+# working Windows snapshot contained torch 2.14.0+cpu with torchaudio 2.11.0.
+# Matching binaries avoid ABI surprises while preserving the same torch series.
+RUN python -m pip install --upgrade pip setuptools wheel \
+    && python -m pip install \
+        --index-url "${TORCH_INDEX_URL}" \
+        "torch==${TORCH_VERSION}" \
+        "torchaudio==${TORCHAUDIO_VERSION}"
+
+# The exact top-level versions below are taken from the supplied working
+# Windows environment snapshot. madmom-prebuilt has a CPython 3.13 manylinux
+# wheel, avoiding the fragile source/Cython build of historical madmom.
+RUN python -m pip install -r /opt/stemlab-docker/requirements.lock.txt
+
+RUN /opt/stemlab-docker/install-sonic-annotator.sh \
+    && /opt/stemlab-docker/install-vamp-pack.sh \
+    && /opt/stemlab-docker/install-stemlab.sh \
+    && /opt/stemlab-docker/verify-environment.sh --build
+
+WORKDIR /work
+ENTRYPOINT ["/opt/stemlab-docker/entrypoint.sh"]
diff --git a/docker/README.md b/docker/README.md
new file mode 100644
index 0000000..ed2a46a
--- /dev/null
+++ b/docker/README.md
@@ -0,0 +1,60 @@
+# StemLab Docker Compose environment
+
+This environment is designed from the supplied known-working Windows snapshot.
+It uses Python 3.13, PyTorch 2.14, the same pinned top-level Python package
+versions where they are portable, Sonic Annotator 1.7, and Vamp Plugin Pack
+2.0. It also installs the current StemLab GitHub release; when the repository
+has no published GitHub Release it falls back to `main`.
+
+## GPU run
+
+Requires Docker Desktop / Docker Engine with NVIDIA Container Toolkit GPU
+support. Put any music file in `./music`, then run:
+
+```bash
+docker compose build --pull
+docker compose run --rm stemlab
+```
+
+The default smoke test uses the `fast` StemLab profile so it can verify the
+complete CLI without forcing the 53-stem model to run on an 8 GB GPU. To run a
+larger profile:
+
+```bash
+STEMLAB_TEST_PROFILE=practical docker compose run --rm stemlab
+STEMLAB_TEST_PROFILE=full docker compose run --rm stemlab
+```
+
+The full profile may require substantially more VRAM than an RTX 4060 Ti 8 GB,
+particularly for Mega-53. Backend failures are still written to
+`analysis.json`, consistent with normal StemLab behaviour.
+
+## CPU run
+
+```bash
+docker compose --profile cpu run --rm stemlab-cpu
+```
+
+## Select a specific file
+
+```bash
+STEMLAB_AUDIO_FILE=my-song.wav docker compose run --rm stemlab
+```
+
+## Use a specific StemLab tag or commit
+
+```bash
+STEMLAB_REF=v0.2.0 docker compose build --no-cache stemlab
+```
+
+`STEMLAB_REF=latest` is the default. It queries the GitHub releases API during
+build and falls back to `main` if no GitHub Release exists.
+
+## Caches and outputs
+
+Model and Hugging Face downloads are stored in named Docker volumes so that
+large model weights are not downloaded for every run. Analysis output is
+written to `./docker-output` by default.
+
+The image runs `stemlab bootstrap all` on first execution. This prepares SCNet,
+Beat Transformer, and verifies the Vamp stack before analysing audio.
diff --git a/docker/entrypoint.sh b/docker/entrypoint.sh
new file mode 100644
index 0000000..b82d0ae
--- /dev/null
+++ b/docker/entrypoint.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -gt 0 ]]; then
+    exec "$@"
+fi
+
+/opt/stemlab-docker/verify-environment.sh runtime
+
+if [[ "${STEMLAB_BOOTSTRAP_MODELS:-1}" == "1" ]]; then
+    echo "=== Bootstrapping StemLab external model runtimes ==="
+    stemlab bootstrap all
+fi
+
+if [[ "${STEMLAB_AUTO_TEST:-1}" != "1" ]]; then
+    echo "Environment ready. STEMLAB_AUTO_TEST=0, so no audio analysis was run."
+    exec bash
+fi
+
+audio="${STEMLAB_AUDIO_FILE:-}"
+if [[ -n "$audio" && "$audio" != /* ]]; then
+    audio="/music/$audio"
+fi
+
+if [[ -z "$audio" ]]; then
+    audio="$(find /music -maxdepth 2 -type f \
+        \( -iname '*.wav' -o -iname '*.flac' -o -iname '*.mp3' -o -iname '*.ogg' -o -iname '*.aif' -o -iname '*.aiff' \) \
+        -print -quit 2>/dev/null || true)"
+fi
+
+if [[ -z "$audio" || ! -f "$audio" ]]; then
+    cat <<'MSG'
+StemLab Docker environment is ready, but no music file was found.
+Place any WAV/FLAC/MP3/OGG/AIFF file in ./music and run:
+
+    docker compose run --rm stemlab
+
+or set STEMLAB_AUDIO_FILE to a filename in that directory.
+MSG
+    exit 0
+fi
+
+profile="${STEMLAB_TEST_PROFILE:-fast}"
+device="${STEMLAB_DEVICE:-auto}"
+name="$(basename "$audio")"
+name="${name%.*}"
+out="/output/${name}-${profile}"
+
+rm -rf "$out"
+echo "=== Smoke-testing StemLab ==="
+echo "audio:   $audio"
+echo "profile: $profile"
+echo "device:  $device"
+echo "output:  $out"
+
+stemlab analyze "$audio" --output "$out" --profile "$profile" --device "$device"
+
+echo "=== StemLab smoke test completed ==="
+ls -la "$out"
diff --git a/docker/install-sonic-annotator.sh b/docker/install-sonic-annotator.sh
